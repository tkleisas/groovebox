# Build output (CMake/MSVC) — regenerable
emulator/build/
emulator/build-pi-arm64/
panel-fw/build/
panel-fw/build.log

# Large Raspberry Pi OS images and flash logs
os-image/*.img.xz
os-image/flash.log

# Local credentials — never commit (use userconf.txt.example)
os-image/customize/password.txt
os-image/customize/userconf.txt

# OS / editor noise
Thumbs.db
.DS_Store

# KiCad noise
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache

# NSR-2 disposable artifacts (regenerable / vendor reference)
nsr2/hardware/**/*.kicad_prl
nsr2/hardware/**/erc*.json
nsr2/hardware/**/io_net.net
nsr2/hardware/**/*_outline.pdf
nsr2/hardware/**/*_outline.png
nsr2/hardware/**/*_sch.pdf
nsr2/tools/__pycache__/
nsr2/hardware/ht16k33_datasheet.pdf
nsr2/hardware/ht16k33_ds2.pdf
nsr2/hardware/HT16K33Av111.pdf
nsr2/hardware/ht16k33_pins*.png
nsr2/hardware/ht16k33a_28sop.png


# Emulator test artifacts (dumps, takes, local settings)
*.rgb565
samples/
settings.json
